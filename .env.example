# Public application URL, without a trailing slash.
APP_URL=

# Existing Supabase project. Use the service-role key only on the server.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret for cron endpoints (token refresh, etc.). Generate with: openssl rand -base64 32
CRON_SECRET=

# Meta application configuration. Keep META_GRAPH_API_VERSION current in Meta's docs.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# Facebook Login for Business configuration: "Volitex AI - WA Coexistence".
META_WHATSAPP_CONFIG_ID=1755274959112811
# Six-digit two-step verification PIN used only to register fresh Cloud API
# numbers after a standard FINISH event. It is never used for Coexistence.
META_WHATSAPP_REGISTRATION_PIN=
# Instagram API with Instagram Login OAuth configuration.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://connect.volitexai.tech/api/connect/instagram/callback

# Optional; required for self-service password resets in production.
RESEND_API_KEY=
EMAIL_FROM=
